# PostgreSQL de desarrollo o Supabase Transaction pooler con TLS.
DATABASE_URL=
# Opcional. Supabase Session pooler para migraciones y seed.
MIGRATION_DATABASE_URL=
# Opcional en local. Generar 32 bytes aleatorios y codificarlos en hexadecimal.
ADMIN_API_KEY=
# Obligatorio en Vercel. Usar un secreto distinto de ADMIN_API_KEY.
RATE_LIMIT_SECRET=
# Opcional. Sustituye el enlace al repositorio original en copias del proyecto.
GITHUB_REPO_URL=
# Orígenes administrativos separados por comas. Por defecto, solo mismo origen.
ADMIN_CORS_ORIGINS=
PORT=3000
LOG_LEVEL=info
